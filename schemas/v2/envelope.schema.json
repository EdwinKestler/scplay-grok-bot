{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EdwinKestler/scplay-grok-bot/schemas/v2/envelope.schema.json",
  "title": "Schema v2 common envelope",
  "description": "Required fields on every schema v2 record. Type-specific schemas add further required properties.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "game_loop",
    "source",
    "event_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "game_loop": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "logger",
        "bot",
        "human",
        "sc2",
        "llm",
        "system"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run_manifest",
        "gameplay_event",
        "chat",
        "snapshot",
        "llm_decision"
      ]
    },
    "game_time_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EdwinKestler/scplay-grok-bot/schemas/v2/chat.schema.json",
  "title": "Chat event (schema v2)",
  "description": "In-match chat line (bot, human, or system). Privacy-sensitive; redaction is Day 13.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "game_loop",
    "source",
    "event_type",
    "speaker",
    "message"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "game_loop": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "logger",
        "bot",
        "human",
        "sc2",
        "llm",
        "system"
      ]
    },
    "event_type": {
      "type": "string",
      "const": "chat"
    },
    "game_time_s": {
      "type": "number",
      "minimum": 0
    },
    "speaker": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "player_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "logged_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
